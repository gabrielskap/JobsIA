# ==========================================
# Estagio 1: Build do Frontend (React + Vite)
# ==========================================
FROM node:20-alpine AS build

WORKDIR /app

# Instalar dependencias com base no lockfile para consistência
COPY package.json package-lock.json ./
RUN npm ci

# Copiar codigo fonte e arquivos de configuracao
COPY tsconfig.json tsconfig.server.json vite.config.ts index.html ./
COPY src/ ./src/
COPY public/ ./public/

# Executar build de producao do frontend (gera pasta /app/dist)
# Nao definimos VITE_API_URL para que o frontend use '/api' (relativo) por padrao
RUN npm run build

# ==========================================
# Estagio 2: Servidor Nginx (Producao)
# ==========================================
# Imagem oficial do Nginx rodando como usuario nao-root (nginx) na porta 8080
FROM nginxinc/nginx-unprivileged:alpine

# Copiar configuracao otimizada de producao do Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copiar estaticos compilados do frontend do estagio anterior
COPY --from=build /app/dist /usr/share/nginx/html

# Expor a porta 8080 (porta padrao nao-root)
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
