{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "dist-server",
    "rootDir": "server"
  },
  "include": ["server"],
  "exclude": ["node_modules", "dist"]
}
