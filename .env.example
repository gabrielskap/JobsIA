# Banco de dados PostgreSQL
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco?sslmode=disable

# Segredo para assinar tokens JWT (use um valor longo e aleatório)
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# Porta do servidor API (padrão: 3001)
PORT=3001

# Origem permitida pelo CORS (URL do frontend em produção)
CORS_ORIGIN=http://localhost:3000

# Chave da API Gemini
VITE_GEMINI_API_KEY=sua_chave_aqui
