# -----------------------------------------------------------------------------
# JOBSIA - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# -----------------------------------------------------------------------------

# URL de Conexão com o Banco de Dados PostgreSQL
# Exemplo: postgresql://<usuario>:<senha>@<host>:<porta>/<banco>?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/jobsia_db?sslmode=disable

# Chave secreta usada para assinar e validar os tokens JWT
# IMPORTANTE: Use um segredo longo, complexo e aleatório em ambiente de produção.
JWT_SECRET=substitua_por_um_hash_aleatorio_e_seguro_de_pelo_menos_256_bits

# Porta em que o servidor backend Express irá rodar
PORT=3001

# URL do frontend React (origem para o middleware de CORS do backend)
CORS_ORIGIN=http://localhost:3000

# URL da API do Backend consumida pelo frontend (Vite)
VITE_API_URL=http://localhost:3001

# URL da API do componente inteligente LIA (OCI Dataprev)
LIA_API_URL=https://lia.oci.dataprev.gov.br

# Chave de Autenticação/API Token da LIA
LIA_API_KEY=sua_chave_de_acesso_lia_aqui

# Modelo de IA a ser utilizado para as análises de jobs e checklists
LIA_API_MODEL=claude-sonnet

# Caminho do endpoint do chat completions da LIA
LIA_API_PATH=/api/v1/chat/completions
